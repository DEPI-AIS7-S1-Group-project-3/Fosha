From f5c459876ffc6e8c589c8e03df6f6df7af0e8940 Mon Sep 17 00:00:00 2001
From: Asaad <assadelbadawy24@gmail.com>
Date: Wed, 21 Oct 2026 21:11:59 +0300
Subject: [PATCH 6/7] ci: run tests on every PR and gate RAG quality when
 retrieval changes

ci.yml validates the eval dataset and runs pytest. rag-eval.yml builds the
index and runs rag.eval with the quality gate when rag/ or the dataset change
(or on manual dispatch), and uploads the JSON report.
---
 .github/workflows/ci.yml       | 21 +++++++++++++++++++++
 .github/workflows/rag-eval.yml | 34 ++++++++++++++++++++++++++++++++++
 2 files changed, 55 insertions(+)
 create mode 100644 .github/workflows/ci.yml
 create mode 100644 .github/workflows/rag-eval.yml

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
new file mode 100644
index 0000000..4799916
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,21 @@
+name: CI
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+
+jobs:
+  tests:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: astral-sh/setup-uv@v5
+        with:
+          enable-cache: true
+      - name: Install dependencies
+        run: uv sync --frozen --python 3.12
+      - name: Check the labelled RAG evaluation dataset
+        run: uv run python -m rag.eval --validate
+      - name: Run tests
+        run: uv run pytest -q
diff --git a/.github/workflows/rag-eval.yml b/.github/workflows/rag-eval.yml
new file mode 100644
index 0000000..a777511
--- /dev/null
+++ b/.github/workflows/rag-eval.yml
@@ -0,0 +1,34 @@
+name: RAG evaluation
+
+# Builds the real Chroma index and fails if retrieval quality drops (quality gate in rag/eval.py).
+# Slow (downloads the embedding model), so it runs only when retrieval code or data changes,
+# or when started by hand from the Actions tab.
+on:
+  pull_request:
+    paths:
+      - "rag/**"
+      - "data/raw_attractions.json"
+  workflow_dispatch:
+
+jobs:
+  rag-eval:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: astral-sh/setup-uv@v5
+        with:
+          enable-cache: true
+      - name: Install dependencies
+        run: uv sync --frozen --python 3.12
+      - name: Build the index
+        run: uv run python -m rag.ingest
+      - name: Evaluate retrieval
+        # Baseline headline Hit@3 is 96.8% and MRR@5 0.935; the gate leaves room for noise.
+        run: uv run python -m rag.eval --json eval-report.json --min-hit3 0.90 --min-mrr 0.85
+      - name: Upload the report
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: rag-eval-report
+          path: eval-report.json
+          if-no-files-found: ignore
-- 
