# Settings for the self-hosted Langfuse server (docker-compose.langfuse.yml).
#   cp .env.langfuse.example .env.langfuse     (.env.langfuse is gitignored: never commit it)
# Replace every CHANGEME. Generate secrets with:  openssl rand -hex 32

POSTGRES_PASSWORD=CHANGEME
CLICKHOUSE_PASSWORD=CHANGEME
MINIO_ROOT_PASSWORD=CHANGEME
REDIS_AUTH=CHANGEME
SALT=CHANGEME
ENCRYPTION_KEY=CHANGEME
NEXTAUTH_SECRET=CHANGEME

# URL people type in the browser. Change it if the UI is not on this machine.
NEXTAUTH_URL=http://localhost:3000
# 127.0.0.1 = this machine only. 0.0.0.0 = reachable by teammates (use HTTPS in front).
LANGFUSE_BIND=127.0.0.1

# Admin login created on the first start.
LANGFUSE_INIT_USER_EMAIL=you@example.com
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=CHANGEME

# The project's API keys, created on the first start. Use any values that keep these prefixes,
# then put the SAME two values in the app's .env (LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY).
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGEME
LANGFUSE_SECRET_KEY=sk-lf-CHANGEME
